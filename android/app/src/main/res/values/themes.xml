<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Hippomaps" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="Theme.Hippomaps.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/page_bg</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Hippomaps</item>
    </style>
</resources>
